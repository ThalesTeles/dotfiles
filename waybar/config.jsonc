// -*- mode: jsonc -*-

{
  // Cores do calendário geradas pelo matugen (templates/waybar_calendar.jsonc)
  "include": ["~/.config/waybar/calendar.jsonc"],
  "layer": "top",
  "height": 20,
  "modules-left": ["hyprland/workspaces", "hyprland/submap", "tray", "mpris"],
  "modules-center": ["custom/power","clock","custom/dunst","idle_inhibitor"],
  "modules-right": ["privacy", "cpu", "temperature", "network", "bluetooth", "pulseaudio", "custom/microfone", "custom/brilho", "custom/modo-energia", "battery"],

  // Modules Configuration
  // "hyprland/window": {
  //   "max-length": 50,
  //   "separate-outputs": true
  // },

  "hyprland/workspaces": {
    "persistent-workspaces": {
        "*": 5
      }
  },

  "network": {
    "interval": 5,
    "format-wifi": "",
    "format-ethernet": "",
    "format-disconnected": "",
    "tooltip-format-wifi": "{essid} · sinal {signalStrength}% · {frequency} GHz\n{ipaddr} via {ifname}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "tooltip-format-ethernet": "Cabo · {ifname}\n{ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "tooltip-format-disconnected": "Sem conexão",
    "on-click": "kitty -e nmtui"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-bluetooth": "󰋋",
    "format-muted": "󰝟",
    "format-bluetooth-muted": "󰟎",
    // Em 0% mostra o alto-falante sem ondas (sem som, mas não mudo)
    "states": {
      "silencio": 0,
      "som": 1
    },
    "format-silencio": "󰕿",
    "format-bluetooth-silencio": "󰋋",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["󰖀", "󰕾"]
    },
    "on-click-right": "pavucontrol",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "ignored-sinks": ["Easy Effects Sink"],
    "tooltip": true,
    "tooltip-format": "{desc} · {volume}%\nClique: mudo · Rolar: volume · Direito: pavucontrol"
  },

  // Microfone: mudo, livre ou em uso (atualiza por eventos do PipeWire)
  "custom/microfone": {
    "exec": "~/.config/waybar/scripts/microfone.sh",
    "return-type": "json",
    "restart-interval": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-click-right": "pavucontrol -t 4",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}",
    "format-icons":{
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
      },
    "on-click": "~/.config/rofi/applets/bin/battery.sh",
    "max-length": 25,
    "format-time": "{H}h{M:02}",
    "tooltip-format": "{capacity}%",
    "tooltip-format-discharging": "{capacity}% · {time} restantes\n{power:.1f} W · {cycles} ciclos",
    "tooltip-format-charging": "{capacity}% · cheia em {time}\n{power:.1f} W · {cycles} ciclos",
    "tooltip-format-full": "Carga completa · {cycles} ciclos"
  },

  // Ícone do modo de energia, colado à esquerda da bateria
  "custom/modo-energia": {
    "exec": "~/.config/waybar/scripts/modo-energia.sh",
    "return-type": "json",
    "interval": 10,
    "signal": 8,
    "on-click": "~/.config/rofi/applets/bin/battery.sh"
  },

  // Brilho da tela, com cadeado quando o modo Economia trava em 40%
  "custom/brilho": {
    "exec": "~/.config/waybar/scripts/brilho.sh",
    "return-type": "json",
    "interval": 30,
    "signal": 10,
    "on-scroll-up": "~/.config/hypr/scripts/modo-energia.sh brilho up",
    "on-scroll-down": "~/.config/hypr/scripts/modo-energia.sh brilho down"
  },

  // Só aparece enquanto algum app compartilha a tela (o microfone tem módulo próprio)
  "privacy": {
    "icon-size": 18,
    "icon-spacing": 4,
    "modules": [
      { "type": "screenshare", "tooltip": true, "tooltip-icon-size": 24 }
    ]
  },

  // Só aparecem quando passam do limite
  "cpu": {
    "interval": 5,
    "states": { "alto": 80 },
    "format": "",
    "format-alto": "󰻠 {usage}%",
    "tooltip": false
  },

  "temperature": {
    "interval": 5,
    // Sensor da CPU (k10temp, Tctl); caminho fixo porque o número do hwmon muda entre boots
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 80,
    "format": "",
    "format-critical": "󰔏 {temperatureC}°C",
    "tooltip": false
  },

  // Mídia tocando (some quando não há player)
  "mpris": {
    "format": "{player_icon} {title}",
    "format-paused": "{status_icon} {title}",
    "max-length": 30,
    "player-icons": {
      "default": "󰎆",
      "spotify": "",
      "firefox": ""
    },
    "status-icons": {
      "paused": "󰏤"
    },
    "tooltip-format": "{artist} — {title}\n{album}\nClique: tocar/pausar · Rolar: faixa",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },

  "clock": {
    // Data em português sem mudar o idioma do sistema (só este módulo)
    "locale": "pt_BR.UTF-8",
    "format-alt": "{:L%H:%M}",
    "format": "{:L%a %d %b %R}",
    "tooltip": true,
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode"          : "year",
      "mode-mon-col"  : 3,
      "on-scroll"     : 1
      // As cores ("format") vêm do calendar.jsonc gerado pelo matugen
    },
    "actions":  {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  // Atualiza por eventos do dunst (D-Bus), sem polling
  "custom/dunst": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/dunst.sh",
    "on-click": "dunstctl set-paused toggle",
    "on-click-right": "dunstctl history-pop",
    "on-click-middle": "dunstctl close-all",
    "restart-interval": 5,
    "return-type": "json",
    "tooltip": true
  },

  // Não suspender: pausa o hypridle (escurecer, bloquear, desligar a tela e suspender)
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰛊"
    },
    "tooltip-format-activated": "Não suspender: ativado\nA tela não escurece, não bloqueia nem suspende\nClique: desativar",
    "tooltip-format-deactivated": "Não suspender: desativado\nEscurece em 2,5 min, bloqueia em 5 min, desliga a tela em 5,5 min\ne suspende em 15 min na bateria · Clique: ativar"
  },

  "tray": {
    "icon-size": 35,
    "spacing": 6
  },

  "bluetooth": {
    "format-on": "",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "format-disabled": "󰂲",
    "tooltip-format-on": "Bluetooth ligado · nenhum aparelho conectado\nClique: desligar · Direito: blueman",
    "tooltip-format-off": "Bluetooth desligado\nClique: ligar",
    "tooltip-format-disabled": "Bluetooth bloqueado (rfkill)",
    "tooltip-format-connected": "{num_connections} conectado(s):\n{device_enumerate}\nClique: desligar · Direito: blueman",
    "tooltip-format-enumerate-connected": "  {device_alias}",
    "tooltip-format-enumerate-connected-battery": "  {device_alias} · bateria {device_battery_percentage}%",
    "on-click": "bluetoothctl show | grep -q \"Powered: yes\" && bluetoothctl power off || bluetoothctl power on",
    "on-click-right": "blueman-manager"
  },

  "custom/power": {
    "format" : "⏻",
      "tooltip": false,
      "menu": "on-click",
      "menu-file": "~/.config/waybar/power_menu.xml",
      "menu-actions": {
        "lock": "hyprlock",
        "shutdown": "systemctl poweroff",
        "reboot": "systemctl reboot",
        "suspend": "systemctl suspend",
        "hibernate": "systemctl hibernate"
      }
  }
}
