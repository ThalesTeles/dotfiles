// -*- mode: jsonc -*-

{
  "layer": "top",
  "height": 20,
  "modules-left": ["hyprland/workspaces", "hyprland/submap", "tray"],
  "modules-center": ["custom/power","clock","custom/dunst"],
  "modules-right": ["network","bluetooth", "pulseaudio", "custom/modo-energia", "battery"],

  // Modules Configuration
  // "hyprland/window": {
  //   "max-length": 50,
  //   "separate-outputs": true
  // },

  "hyprland/workspaces": {
    "persistent-workspaces": {
        "*": 5
      }
  },

  "network": {
    "interval": 5,
    "format-wifi": "",
    "format-ethernet": "",
    "format-disconnected": "",
    "tooltip-format-wifi": "{essid} · sinal {signalStrength}% · {frequency} GHz\n{ipaddr} via {ifname}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "tooltip-format-ethernet": "Cabo · {ifname}\n{ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "tooltip-format-disconnected": "Sem conexão",
    "on-click": "kitty -e nmtui"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-bluetooth": "{icon} ",
    "format-muted": "󰝟",
    "format-bluetooth-muted": "󰝟 ",
    // Em 0% mostra o alto-falante sem ondas (sem som, mas não mudo)
    "states": {
      "silencio": 0,
      "som": 1
    },
    "format-silencio": "󰕿",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["󰖀", "󰕾"]
    },
    "on-click-right": "pavucontrol",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "ignored-sinks": ["Easy Effects Sink"],
    "tooltip": true,
    "tooltip-format": "{desc} · {volume}%\nClique: mudo · Rolar: volume · Direito: pavucontrol"
  },


  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}",
    "format-icons":{
      "default": ["", "", "", "", ""],
      "charging": [" 󰚥", " 󰚥", " 󰚥", " 󰚥", " 󰚥"]
      },
    "on-click": "~/.config/rofi/applets/bin/battery.sh",
    "max-length": 25,
    "format-time": "{H}h{M:02}",
    "tooltip-format": "{capacity}%",
    "tooltip-format-discharging": "{capacity}% · {time} restantes\n{power:.1f} W · {cycles} ciclos",
    "tooltip-format-charging": "{capacity}% · cheia em {time}\n{power:.1f} W · {cycles} ciclos",
    "tooltip-format-full": "Carga completa · {cycles} ciclos"
  },

  // Ícone do modo de energia, colado à esquerda da bateria
  "custom/modo-energia": {
    "exec": "~/.config/waybar/scripts/modo-energia.sh",
    "return-type": "json",
    "interval": 10,
    "signal": 8,
    "on-click": "~/.config/rofi/applets/bin/battery.sh"
  },

  "clock": {
    "format-alt": "{:%H:%M}",
    "format": "{:%a %b %d %R}",
    "tooltip": true,
    "tooltip-format": "{:%Y-%m-%d}",
    "calendar": {
      "mode"          : "year",
      "mode-mon-col"  : 3,
      "weeks-pos"     : "right",
      "on-scroll"     : 1,
      "format": {
        "months":     "<span color='#ffead3'><b>{}</b></span>",
        "days":       "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
        "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
    "actions":  {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "custom/dunst": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/dunst.sh",
    "on-click": "dunstctl set-paused toggle",
    "on-click-right": "dunstctl history-pop",
    "on-click-middle": "dunstctl close-all",
    "interval": 1,
    "return-type": "json",
    "tooltip": true
  },

  "tray": {
    "icon-size": 35,
    "spacing": 6
  },

  "bluetooth": {
    "format-on": "",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "format-disabled": "󰂲",
    "tooltip-format-on": "Bluetooth ligado · nenhum aparelho conectado\nClique: desligar · Direito: blueman",
    "tooltip-format-off": "Bluetooth desligado\nClique: ligar",
    "tooltip-format-disabled": "Bluetooth bloqueado (rfkill)",
    "tooltip-format-connected": "{num_connections} conectado(s):\n{device_enumerate}\nClique: desligar · Direito: blueman",
    "tooltip-format-enumerate-connected": "  {device_alias}",
    "tooltip-format-enumerate-connected-battery": "  {device_alias} · bateria {device_battery_percentage}%",
    "on-click": "bluetoothctl show | grep -q \"Powered: yes\" && bluetoothctl power off || bluetoothctl power on",
    "on-click-right": "blueman-manager"
  },

  "custom/power": {
    "format" : "⏻",
      "tooltip": false,
      "menu": "on-click",
      "menu-file": "~/.config/waybar/power_menu.xml",
      "menu-actions": {
        "lock": "hyprlock",
        "shutdown": "systemctl poweroff",
        "reboot": "systemctl reboot",
        "suspend": "systemctl suspend",
        "hibernate": "systemctl hibernate"
      }
  }
}
